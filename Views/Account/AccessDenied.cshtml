@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Access Denied";
}

<div class="login-header">
    <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle mb-3 shadow" style="background-color: #ef4444; width: 64px; height: 64px;">
        <i class="bi bi-shield-x text-white fs-2"></i>
    </div>
    <h3 class="fw-bold mb-1">Access Restricted</h3>
    <p class="text-white-50 mb-0 small">PERMISSION DENIED</p>
</div>

<div class="login-body text-center">
    <p class="text-muted mb-4">
        You do not possess the required security authorization to view this module.
    </p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-hrms-teal w-100 py-2">
        <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
    </a>
</div>

