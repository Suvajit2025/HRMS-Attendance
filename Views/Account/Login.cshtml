@model HRMS.ViewModels.LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "System Login";
}

<div class="login-header">
    <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-2 shadow-sm" style="background: linear-gradient(135deg, #0d9488, #14b8a6); width: 48px; height: 48px;">
        <i class="bi bi-shield-lock-fill text-white fs-4"></i>
    </div>
    <h4 class="fw-bold text-dark mb-0 tracking-tight" style="letter-spacing: -0.3px;">HRMS Portal</h4>
    <p class="text-muted mb-0 small" style="font-size: 0.8rem; font-weight: 500;">Workforce & Attendance System</p>
</div>

<div class="login-body">
    @if (User?.Identity?.IsAuthenticated == true)
    {
        <div class="alert alert-info py-2 px-3 small rounded-2 mb-3 d-flex align-items-center justify-content-between" role="alert">
            <div>
                <i class="bi bi-person-check-fill me-1"></i> Logged in as: <strong>@User.Identity?.Name</strong>
            </div>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold" style="font-size: 0.75rem;">
                Dashboard &rarr;
            </a>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center py-2 px-3 small rounded-2 mb-3" role="alert">
            <i class="bi bi-exclamation-circle-fill me-2 fs-6"></i>
            <div>@Model.ErrorMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-controller="Account" asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="mb-3">
            <label asp-for="Username" class="form-label fw-semibold small text-dark mb-1"></label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person"></i></span>
                <input asp-for="Username" class="form-control border-start-0 ps-0" placeholder="Username" autofocus required />
            </div>
            <span asp-validation-for="Username" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-semibold small text-dark mb-1"></label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-key"></i></span>
                <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="Password" required />
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
            </div>
            <span class="badge bg-light text-secondary border small py-1 px-2">Local Demo</span>
        </div>

        <button type="submit" class="btn btn-hrms-teal w-100 py-2 fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-box-arrow-in-right"></i>
            <span>Sign In</span>
        </button>

        <div class="mt-3 p-2 bg-light rounded-2 border text-center" style="font-size: 0.8rem;">
            <div class="text-muted">
                Default Credentials: <code class="fw-bold text-dark">admin</code> / <code class="fw-bold text-dark">123</code>
            </div>
        </div>
    </form>
</div>
