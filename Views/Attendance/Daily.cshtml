@model HRMS.ViewModels.DailyAttendanceViewModel
@{
    ViewData["Title"] = $"Daily Attendance — {Model.Date:dd MMM yyyy}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">Daily Attendance Sheet</h4>
        <div class="text-muted small">Workforce muster roll for <strong>@Model.Date.ToString("dddd, dd MMMM yyyy")</strong></div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Dashboard" asp-action="ExportTodayCsv" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-departmentId="@Model.DepartmentId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-download me-1"></i> Export CSV
        </a>
    </div>
</div>

<!-- Date & Filters Card -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Daily" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-3">
                <select name="departmentId" class="form-select">
                    <option value="">All Departments</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.DepartmentId" selected="@(string.Equals(Model.DepartmentId, dept.DepartmentId, StringComparison.OrdinalIgnoreCase))">
                            @dept.DepartmentName
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search employee name or EMP ID..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold" style="background-color:#1e293b; border-color:#1e293b;">
                    Filter
                </button>
                @if (Model.Date != DateOnly.FromDateTime(DateTime.Today) || !string.IsNullOrEmpty(Model.DepartmentId) || !string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-action="Daily" class="btn btn-outline-secondary" title="Reset to Today">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Daily Summary Metrics -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon-wrap kpi-icon-teal">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <div class="kpi-number">@Model.TotalEmployees</div>
                <div class="kpi-label">Active Total</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon-wrap kpi-icon-green">
                <i class="bi bi-person-check-fill"></i>
            </div>
            <div>
                <div class="kpi-number">@Model.PresentCount</div>
                <div class="kpi-label">Present</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon-wrap kpi-icon-blue">
                <i class="bi bi-door-open-fill"></i>
            </div>
            <div>
                <div class="kpi-number">@Model.InsideCount</div>
                <div class="kpi-label">Currently Inside</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon-wrap kpi-icon-red">
                <i class="bi bi-person-x-fill"></i>
            </div>
            <div>
                <div class="kpi-number">@Model.AbsentCount</div>
                <div class="kpi-label">Absent</div>
            </div>
        </div>
    </div>
</div>

<!-- Daily Attendance Table -->
<div class="card border shadow-sm rounded-3 mb-4 overflow-hidden">
    <div class="table-responsive" style="max-height: 68vh; overflow-y: auto;">
        <table class="table hrms-table table-hover align-middle mb-0">
            <thead class="sticky-top" style="z-index: 5;">
                <tr>
                    <th style="width: 50px;">Photo</th>
                    <th>EMP No</th>
                    <th>Employee Name</th>
                    <th>Department</th>
                    <th>First IN</th>
                    <th>Last OUT</th>
                    <th>Working Hours</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Records.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                            <div>No attendance records found for this date.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.Records)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(row.PhotoPath) ? "/images/avatar-default.png" : row.PhotoPath)"
                                     alt="@row.EmployeeName"
                                     class="rounded-circle border"
                                     style="width: 38px; height: 38px; object-fit: cover;" />
                            </td>
                            <td>
                                <span class="fw-bold font-monospace">@row.EmployeeNo</span>
                            </td>
                            <td>
                                <a asp-controller="Employee" asp-action="Details" asp-route-id="@row.EmployeeId" class="fw-bold text-dark text-decoration-none">
                                    @row.EmployeeName
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(row.DepartmentName ?? "Unassigned")
                                </span>
                            </td>
                            <td class="font-monospace">
                                @(row.FirstInTime.HasValue ? row.FirstInTime.Value.ToString("hh:mm:ss tt") : "--:--:--")
                            </td>
                            <td class="font-monospace">
                                @(row.LastOutTime.HasValue ? row.LastOutTime.Value.ToString("hh:mm:ss tt") : "--:--:--")
                            </td>
                            <td class="font-monospace text-muted small">
                                @row.WorkingHoursFormatted
                            </td>
                            <td>
                                <span class="badge @row.StatusBadgeClass px-2 py-1">
                                    @row.AttendanceStatus
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

