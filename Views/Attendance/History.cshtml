@model HRMS.ViewModels.AttendanceHistoryViewModel
@{
    ViewData["Title"] = "Employee Attendance History";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">Attendance History & Audit Logs</h4>
        <div class="text-muted small">Historical punch logs for <strong>@Model.SelectedEmployeeName (@Model.SelectedEmployeeNo)</strong></div>
    </div>
    <a asp-action="Daily" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-calendar-check me-1"></i> Today's Sheet
    </a>
</div>

<!-- History Filter Card -->
<div class="card border shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="History" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small text-muted mb-1">Select Employee</label>
                <select name="employeeId" class="form-select">
                    @foreach (var emp in Model.Employees)
                    {
                        <option value="@emp.EmployeeId" selected="@(string.Equals(Model.SelectedEmployeeId, emp.EmployeeId, StringComparison.OrdinalIgnoreCase))">
                            @emp.EmployeeNo — @emp.FullName (@(emp.DepartmentName ?? "General"))
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Start Date</label>
                <input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">End Date</label>
                <div class="input-group">
                    <input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" />
                    <button type="submit" class="btn btn-outline-secondary px-3 d-flex align-items-center justify-content-center" title="Filter History">
                        <i class="bi bi-funnel"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- History Log Table -->
<div class="card border shadow-sm rounded-3 mb-4 overflow-hidden">
    <div class="table-responsive" style="max-height: 68vh; overflow-y: auto;">
        <table class="table hrms-table table-hover align-middle mb-0">
            <thead class="sticky-top" style="z-index: 5;">
                <tr>
                    <th>Date</th>
                    <th>Punch Type</th>
                    <th>Server Timestamp</th>
                    <th>Verification Mode</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Records.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-clock-history fs-1 d-block mb-2"></i>
                            <div>No punch events found within the selected date range.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var record in Model.Records)
                    {
                        <tr>
                            <td class="fw-semibold">@record.AttendanceDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge @(record.PunchType == "IN" ? "bg-success" : "bg-warning text-dark") px-2 py-1">
                                    @record.PunchType
                                </span>
                            </td>
                            <td class="font-monospace">@record.PunchTime.ToString("hh:mm:ss tt")</td>
                            <td>
                                <span class="small text-muted">
                                    <i class="bi @(record.VerificationMethod == "FaceRecognition" ? "bi-person-bounding-box text-teal" : "bi-hand-index-thumb") me-1"></i>
                                    @record.VerificationMethod
                                </span>
                            </td>
                            <td>
                                @if (record.IsLate)
                                {
                                    <span class="badge badge-late">
                                        <i class="bi bi-clock-history"></i> Late Arrival
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-present">
                                        <i class="bi bi-check-circle-fill"></i> Regular
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

