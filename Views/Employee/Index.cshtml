@model HRMS.ViewModels.EmployeeListViewModel
@{
    ViewData["Title"] = "Employee Directory";
}

@Html.AntiForgeryToken()

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">Employee Directory</h4>
        <div class="text-muted small">Manage industrial workforce personnel, profiles, and credentials</div>
    </div>
    <a asp-action="Create" class="btn btn-hrms-teal fw-semibold shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Add New Employee
    </a>
</div>

<!-- Search & Filters Card -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search by name, EMP ID, or phone..." />
                </div>
            </div>

            <div class="col-md-3">
                <select name="departmentId" class="form-select">
                    <option value="">All Departments</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.DepartmentId" selected="@(string.Equals(Model.DepartmentId, dept.DepartmentId, StringComparison.OrdinalIgnoreCase))">
                            @dept.DepartmentName
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="statusFilter" class="form-select">
                    <option value="all" selected="@(Model.StatusFilter == "all" || string.IsNullOrEmpty(Model.StatusFilter))">All Status</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">Active Only</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive Only</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold" style="background-color:#1e293b; border-color:#1e293b;">
                    Filter
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.DepartmentId) || (!string.IsNullOrEmpty(Model.StatusFilter) && Model.StatusFilter != "all"))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Employee Table Card -->
<div class="card border shadow-sm rounded-3 mb-4 overflow-hidden">
    <div class="table-responsive" style="max-height: 68vh; overflow-y: auto;">
        <table class="table hrms-table table-hover align-middle mb-0">
            <thead class="sticky-top" style="z-index: 5;">
                <tr>
                    <th style="width: 60px;">Photo</th>
                    <th>EMP No</th>
                    <th>Employee Name</th>
                    <th>Department</th>
                    <th>Joining Date</th>
                    <th>Aadhaar No</th>
                    <th>Status</th>
                    <th class="text-end" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Employees.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary"></i>
                            <div class="fw-semibold">No employee records match the filter criteria.</div>
                            <div class="small">Try adjusting search parameters or add a new employee.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var emp in Model.Employees)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(emp.Photo) ? "/images/avatar-default.png" : emp.Photo)"
                                     alt="@emp.FullName"
                                     class="rounded-circle border"
                                     style="width: 40px; height: 40px; object-fit: cover;" />
                            </td>
                            <td>
                                <span class="fw-bold font-monospace text-dark">@emp.EmployeeNo</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@emp.EmployeeId" class="text-decoration-none fw-bold text-dark hover-teal">
                                    @emp.FullName
                                </a>
                                @if (!string.IsNullOrEmpty(emp.PhoneNo))
                                {
                                    <div class="small text-muted font-monospace">@emp.PhoneNo</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(emp.DepartmentName ?? "Unassigned")
                                </span>
                            </td>
                            <td class="text-muted small">
                                @emp.JoiningDate.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <span class="font-monospace small text-muted">
                                    <i class="bi bi-shield-lock text-success me-1"></i> @emp.MaskedAadhaar
                                </span>
                            </td>
                            <td>
                                @if (emp.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@emp.EmployeeId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@emp.EmployeeId" class="btn btn-outline-secondary" title="Edit Profile">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-toggle-status"
                                            data-id="@emp.EmployeeId"
                                            data-active="@emp.IsActive"
                                            title="@(emp.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi @(emp.IsActive ? "bi-toggle-on text-success" : "bi-toggle-off text-muted") fs-6"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center">
            <div class="small text-muted">
                Showing <b>@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</b> to <b>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount))</b> of <b>@Model.TotalCount</b> employees
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-departmentId="@Model.DepartmentId"
                           asp-route-statusFilter="@Model.StatusFilter">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@p"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-departmentId="@Model.DepartmentId"
                               asp-route-statusFilter="@Model.StatusFilter">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-departmentId="@Model.DepartmentId"
                           asp-route-statusFilter="@Model.StatusFilter">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-toggle-status').forEach(btn => {
            btn.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                const isActive = this.getAttribute('data-active') === 'True';
                const action = isActive ? 'deactivate' : 'activate';

                if (!confirm(`Are you sure you want to ${action} this employee?`)) return;

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const formData = new FormData();
                formData.append('id', id);

                const res = await fetch('/Employee/ToggleStatus', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: formData
                });

                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Action failed.');
                }
            });
        });
    </script>
}

