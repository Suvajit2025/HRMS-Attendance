@model HRMS.ViewModels.HolidayCalendarViewModel
@{
    ViewData["Title"] = $"Holiday Calendar — {Model.MonthName}";
    var firstDayOfMonth = new DateOnly(Model.Year, Model.Month, 1);
    int startingDayOfWeek = (int)firstDayOfMonth.DayOfWeek; // 0 = Sunday, 1 = Monday ...
    int daysInMonth = Model.DaysInMonth;

    var prevMonthDate = firstDayOfMonth.AddMonths(-1);
    var nextMonthDate = firstDayOfMonth.AddMonths(1);

    var holidayLookup = Model.Holidays
        .Where(h => h.IsActive && h.HolidayDate.Year == Model.Year && h.HolidayDate.Month == Model.Month)
        .GroupBy(h => h.HolidayDate.Day)
        .ToDictionary(g => g.Key, g => g.ToList());
}

<!-- Calendar Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="bi bi-calendar3-event-fill text-teal me-2" style="color:#0d9488;"></i> Holiday Calendar
        </h4>
        <div class="text-muted small">Visual calendar of public observances, weekly offs, and corporate holidays</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="btn-group shadow-sm">
            <a asp-action="Calendar" asp-route-year="@prevMonthDate.Year" asp-route-month="@prevMonthDate.Month" asp-route-departmentId="@Model.SelectedDepartmentId" asp-route-type="@Model.SelectedHolidayType" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-chevron-left me-1"></i> Prev
            </a>
            <span class="btn btn-light btn-sm fw-bold border-top border-bottom px-3 text-dark">
                @Model.MonthName
            </span>
            <a asp-action="Calendar" asp-route-year="@nextMonthDate.Year" asp-route-month="@nextMonthDate.Month" asp-route-departmentId="@Model.SelectedDepartmentId" asp-route-type="@Model.SelectedHolidayType" class="btn btn-outline-secondary btn-sm">
                Next <i class="bi bi-chevron-right ms-1"></i>
            </a>
        </div>
        <a asp-action="Index" asp-route-year="@Model.Year" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-list-ul me-1"></i> List View
        </a>
        <a asp-action="Create" class="btn btn-hrms-teal btn-sm shadow-sm">
            <i class="bi bi-plus-circle-fill me-1"></i> Add Holiday
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Calendar" class="row g-2 align-items-end">
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Month</label>
                <select name="month" class="form-select form-select-sm" onchange="this.form.submit();">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.Month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Year</label>
                <select name="year" class="form-select form-select-sm" onchange="this.form.submit();">
                    @for (int y = Model.Year - 2; y <= Model.Year + 2; y++)
                    {
                        <option value="@y" selected="@(y == Model.Year)">@y</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-5">
                <label class="form-label small text-muted mb-1">Department Scope</label>
                <div class="input-group input-group-sm">
                    <select name="departmentId" class="form-select" onchange="this.form.submit();">
                        <option value="">All Departments</option>
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d.DepartmentId" selected="@(d.DepartmentId == Model.SelectedDepartmentId)">@d.DepartmentName</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-outline-secondary px-3 d-flex align-items-center justify-content-center" style="height: 31px;" title="Apply Filter">
                        <i class="bi bi-funnel"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Calendar Grid -->
<div class="card border shadow-sm rounded-3 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-bordered mb-0 calendar-table" style="table-layout: fixed;">
            <thead class="bg-light text-center">
                <tr class="text-uppercase small fw-bold">
                    <th class="py-2 text-danger" style="width: 14.28%;">Sun</th>
                    <th class="py-2" style="width: 14.28%;">Mon</th>
                    <th class="py-2" style="width: 14.28%;">Tue</th>
                    <th class="py-2" style="width: 14.28%;">Wed</th>
                    <th class="py-2" style="width: 14.28%;">Thu</th>
                    <th class="py-2" style="width: 14.28%;">Fri</th>
                    <th class="py-2 text-primary" style="width: 14.28%;">Sat</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int dayCounter = 1;
                    int totalCells = startingDayOfWeek + daysInMonth;
                    int totalRows = (int)Math.Ceiling(totalCells / 7.0);

                    for (int row = 0; row < totalRows; row++)
                    {
                        <tr style="height: 105px;">
                            @for (int col = 0; col < 7; col++)
                            {
                                int cellIndex = row * 7 + col;
                                if (cellIndex < startingDayOfWeek || dayCounter > daysInMonth)
                                {
                                    <td class="bg-light bg-opacity-25 text-muted p-2 align-top"></td>
                                }
                                else
                                {
                                    int currentDay = dayCounter;
                                    var currentDate = new DateOnly(Model.Year, Model.Month, currentDay);
                                    bool isSunday = col == 0;
                                    bool isToday = (currentDate == DateOnly.FromDateTime(DateTime.Today));
                                    holidayLookup.TryGetValue(currentDay, out var dayHolidays);

                                    string cellBg = isSunday ? "background-color: #fafbfd;" : "";
                                    if (dayHolidays != null && dayHolidays.Count > 0)
                                    {
                                        cellBg = "background-color: #f0fdfa;";
                                    }

                                    <td class="p-2 align-top position-relative @(isToday ? "border border-2 border-teal" : "")" style="@cellBg">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-bold @(isSunday ? "text-danger" : (isToday ? "badge bg-teal text-white rounded-circle" : "text-dark"))" style="font-size: 0.88rem; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center;">
                                                @currentDay
                                            </span>
                                            @if (isSunday)
                                            {
                                                <span class="badge bg-light text-secondary border small" style="font-size: 0.65rem;">Off</span>
                                            }
                                        </div>

                                        @if (dayHolidays != null)
                                        {
                                            @foreach (var h in dayHolidays)
                                            {
                                                string badgeColor = h.HolidayType switch
                                                {
                                                    "National" => "bg-danger text-white",
                                                    "Festival" => "bg-warning text-dark",
                                                    _ => "bg-teal text-white"
                                                };

                                                <div class="badge @badgeColor text-truncate w-100 p-1 mb-1 text-start" title="@h.HolidayName (@h.HolidayType)" style="font-size: 0.72rem; cursor: pointer;">
                                                    <i class="bi bi-star-fill me-1"></i>@h.HolidayName
                                                </div>
                                            }
                                        }
                                    </td>
                                    dayCounter++;
                                }
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
