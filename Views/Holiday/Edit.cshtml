@model HRMS.Models.HolidayModel
@{
    ViewData["Title"] = $"Edit Holiday — {Model.HolidayName}";
    var departments = ViewBag.Departments as IReadOnlyList<HRMS.Models.DepartmentModel> ?? new List<HRMS.Models.DepartmentModel>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold mb-1 text-dark">Edit Holiday</h4>
                <div class="text-muted small">Update holiday dates and scoping parameters</div>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Holidays
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <form method="post" asp-action="Edit" asp-route-id="@Model.HolidayId">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="HolidayId" />
                    <input type="hidden" asp-for="CreatedDate" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold small text-dark mb-1">Holiday Name <span class="text-danger">*</span></label>
                            <input asp-for="HolidayName" class="form-control" required />
                            <span asp-validation-for="HolidayName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label fw-semibold small text-dark mb-1">Holiday Date <span class="text-danger">*</span></label>
                            <input asp-for="HolidayDate" type="date" class="form-control" required />
                            <span asp-validation-for="HolidayDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark mb-1">Holiday Type</label>
                            <select asp-for="HolidayType" class="form-select">
                                <option value="Public">Public Holiday</option>
                                <option value="National">National Holiday</option>
                                <option value="Festival">Festival Holiday</option>
                                <option value="Optional">Optional / Restricted Holiday</option>
                                <option value="Company">Company / Plant Off</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark mb-1">Department Scope</label>
                            <select asp-for="DepartmentId" class="form-select">
                                <option value="">Entire Organization (All Departments)</option>
                                @foreach (var d in departments)
                                {
                                    <option value="@d.DepartmentId">@d.DepartmentName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark mb-1">Location / Site Code</label>
                            <input asp-for="LocationCode" class="form-control" />
                        </div>

                        <div class="col-md-6 d-flex align-items-center pt-md-4">
                            <div class="form-check form-switch me-4">
                                <input asp-for="IsPaidHoliday" class="form-check-input" type="checkbox" id="checkIsPaid" />
                                <label class="form-check-label fw-semibold small" for="checkIsPaid">Paid Holiday</label>
                            </div>
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="checkIsActive" />
                                <label class="form-check-label fw-semibold small" for="checkIsActive">Active</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-dark mb-1">Description / Notes</label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-hrms-teal px-4 fw-semibold">
                                <i class="bi bi-check-lg me-1"></i> Update Holiday
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

