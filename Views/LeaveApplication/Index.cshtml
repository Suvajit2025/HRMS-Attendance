@model IReadOnlyList<HRMS.Models.LeaveApplicationModel>
@{
    ViewData["Title"] = "Leave Applications";
    var employees = ViewBag.Employees as IReadOnlyList<HRMS.Models.EmployeeModel> ?? new List<HRMS.Models.EmployeeModel>();
    var leaveTypes = ViewBag.LeaveTypes as IReadOnlyList<HRMS.Models.LeaveTypeModel> ?? new List<HRMS.Models.LeaveTypeModel>();
    var empLookup = ViewBag.EmployeeLookup as Dictionary<string, HRMS.Models.EmployeeModel> ?? new Dictionary<string, HRMS.Models.EmployeeModel>();
    var typeLookup = ViewBag.LeaveTypeLookup as Dictionary<string, HRMS.Models.LeaveTypeModel> ?? new Dictionary<string, HRMS.Models.LeaveTypeModel>();
    var deptLookup = ViewBag.DepartmentLookup as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="bi bi-journal-text text-teal me-2" style="color:#0d9488;"></i> Leave Applications
        </h4>
        <div class="text-muted small">Manage workforce leave requests, audit approvals, and track status</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="LeaveApproval" asp-action="Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-check2-circle"></i> Approval Queue
        </a>
        <a asp-action="Create" class="btn btn-hrms-teal btn-sm px-3 d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-pencil-square"></i> Apply For Leave
        </a>
    </div>
</div>

<!-- Filters Card -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Employee</label>
                <select name="employeeId" class="form-select form-select-sm" onchange="this.form.submit();">
                    <option value="">All Employees</option>
                    @foreach (var emp in employees)
                    {
                        <option value="@emp.EmployeeId" selected="@(emp.EmployeeId == ViewBag.SelectedEmployeeId)">@emp.EmployeeNo — @emp.FullName</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small text-muted mb-1">Status</label>
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit();">
                    <option value="All" selected="@(ViewBag.SelectedStatus == "All")">All Statuses</option>
                    <option value="Pending" selected="@(ViewBag.SelectedStatus == "Pending")">Pending Approval</option>
                    <option value="Approved" selected="@(ViewBag.SelectedStatus == "Approved")">Approved</option>
                    <option value="Rejected" selected="@(ViewBag.SelectedStatus == "Rejected")">Rejected</option>
                    <option value="Cancelled" selected="@(ViewBag.SelectedStatus == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small text-muted mb-1">Leave Type</label>
                <select name="leaveTypeId" class="form-select form-select-sm" onchange="this.form.submit();">
                    <option value="All" selected="@(ViewBag.SelectedLeaveTypeId == "All")">All Leave Types</option>
                    @foreach (var lt in leaveTypes)
                    {
                        <option value="@lt.LeaveTypeId" selected="@(lt.LeaveTypeId == ViewBag.SelectedLeaveTypeId)">@lt.LeaveName (@lt.LeaveCode)</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-outline-secondary btn-sm flex-grow-1 fw-semibold d-flex align-items-center justify-content-center" style="height:31px;" title="Apply Filter">
                    <i class="bi bi-funnel"></i>
                </button>
                @if (ViewBag.SelectedEmployeeId != null || ViewBag.SelectedStatus != "All" || ViewBag.SelectedLeaveTypeId != "All")
                {
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center justify-content-center" title="Reset Filters" style="height:31px; width:36px;">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Applications Table -->
<div class="card border shadow-sm rounded-3 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table hrms-table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th>Application Date</th>
                    <th>Employee</th>
                    <th>Leave Type</th>
                    <th>Leave Period</th>
                    <th>Days</th>
                    <th>Status</th>
                    <th>Reason</th>
                    <th class="text-end" style="width: 100px;">Details</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            <div>No leave applications match the selected criteria.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var app in Model)
                    {
                        empLookup.TryGetValue(app.EmployeeId, out var emp);
                        typeLookup.TryGetValue(app.LeaveTypeId, out var lt);

                        string statusBadge = app.Status switch
                        {
                            "Approved" => "bg-success-subtle text-success border border-success-subtle",
                            "Pending" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                            "Rejected" => "bg-danger-subtle text-danger border border-danger-subtle",
                            "Cancelled" => "bg-secondary-subtle text-secondary border",
                            _ => "bg-light text-dark border"
                        };

                        <tr>
                            <td class="small font-monospace">@app.ApplicationDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>
                                <div class="fw-bold text-dark">@(emp?.FullName ?? "Unknown")</div>
                                <div class="text-muted small font-monospace">@(emp?.EmployeeNo ?? "--")</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-teal border fw-semibold">
                                    @(lt?.LeaveName ?? app.LeaveTypeId)
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">
                                    @app.FromDate.ToString("dd MMM yyyy")
                                    @if (app.FromDate != app.ToDate)
                                    {
                                        <span> — @app.ToDate.ToString("dd MMM yyyy")</span>
                                    }
                                </div>
                                @if (app.IsHalfDay)
                                {
                                    <span class="badge bg-light text-muted border small">Half Day (@app.HalfDaySession)</span>
                                }
                            </td>
                            <td class="fw-bold font-monospace">@app.TotalDays</td>
                            <td>
                                <span class="badge @statusBadge px-2 py-1">@app.Status</span>
                            </td>
                            <td class="small text-truncate" style="max-width: 200px;" title="@app.Reason">
                                @app.Reason
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@app.LeaveApplicationId" class="btn btn-outline-secondary btn-sm" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
