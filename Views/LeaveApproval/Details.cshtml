@model HRMS.ViewModels.LeaveApprovalViewModel
@{
    ViewData["Title"] = $"Review Application — {Model.Employee.FullName}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold mb-1 text-dark">Review Leave Application</h4>
                <div class="text-muted small">Application ID: <span class="font-monospace">@Model.Application.LeaveApplicationId</span></div>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Queue
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1 fs-6">Awaiting Decision</span>
                <span class="text-muted small font-monospace">Submitted: @Model.Application.ApplicationDate.ToString("dd MMM yyyy, hh:mm tt")</span>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-sm-6">
                        <div class="text-muted small">Employee</div>
                        <div class="fw-bold fs-6 text-dark">@Model.Employee.FullName</div>
                        <div class="text-muted small font-monospace">@Model.Employee.EmployeeNo &bull; @Model.DepartmentName</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Leave Type</div>
                        <div class="fw-bold fs-6 text-teal" style="color:#0d9488;">
                            @Model.LeaveType.LeaveName (@Model.LeaveType.LeaveCode)
                        </div>
                        <div class="text-muted small">@(Model.LeaveType.IsPaidLeave ? "Paid Leave" : "Unpaid Leave (LOP)")</div>
                    </div>

                    <div class="col-sm-6">
                        <div class="text-muted small">Requested Period</div>
                        <div class="fw-bold text-dark fs-6">
                            @Model.Application.FromDate.ToString("dd MMM yyyy")
                            @if (Model.Application.FromDate != Model.Application.ToDate)
                            {
                                <span> — @Model.Application.ToDate.ToString("dd MMM yyyy")</span>
                            }
                        </div>
                        @if (Model.Application.IsHalfDay)
                        {
                            <span class="badge bg-light text-muted border">Half Day (@Model.Application.HalfDaySession)</span>
                        }
                    </div>

                    <div class="col-sm-3">
                        <div class="text-muted small">Requested Days</div>
                        <div class="fw-bold text-dark fs-4 font-monospace">@Model.Application.TotalDays Day(s)</div>
                    </div>

                    <div class="col-sm-3">
                        <div class="text-muted small">Current Available Balance</div>
                        <div class="fw-bold fs-4 font-monospace @(Model.AvailableBalance >= Model.Application.TotalDays ? "text-success" : "text-danger")">
                            @Model.AvailableBalance Day(s)
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="text-muted small">Employee's Stated Reason</div>
                        <div class="p-3 bg-light rounded-2 border text-dark mt-1">@Model.Application.Reason</div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Application.SupportingDocumentPath))
                    {
                        <div class="col-12">
                            <div class="text-muted small">Supporting Document</div>
                            <div class="mt-1">
                                <a href="@Model.Application.SupportingDocumentPath" target="_blank" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-file-earmark-arrow-down me-1"></i> View / Download Uploaded Document
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-danger px-4 fw-semibold" data-bs-toggle="modal" data-bs-target="#rejectModal">
                        <i class="bi bi-x-circle me-1"></i> Reject Application
                    </button>

                    <form method="post" asp-action="Approve" asp-route-id="@Model.Application.LeaveApplicationId" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success px-4 fw-semibold shadow-sm" onclick="return confirm('Approve leave application for @Model.Employee.FullName (@Model.Application.TotalDays days)?');">
                            <i class="bi bi-check-circle me-1"></i> Approve Leave
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Reject" asp-route-id="@Model.Application.LeaveApplicationId">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-dark">Reject Leave Application</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2">Please provide a clear justification for rejecting this leave request. The employee will be notified and any reserved balance will be restored.</p>
                    <label class="form-label small fw-semibold text-dark">Rejection Reason <span class="text-danger">*</span></label>
                    <textarea name="rejectionReason" class="form-control" rows="3" placeholder="Specify why the leave cannot be approved..." required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

