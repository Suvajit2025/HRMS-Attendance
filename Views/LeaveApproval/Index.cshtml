@model IReadOnlyList<HRMS.Models.LeaveApplicationModel>
@{
    ViewData["Title"] = "Leave Approval Queue";
    var empLookup = ViewBag.EmployeeLookup as Dictionary<string, HRMS.Models.EmployeeModel> ?? new Dictionary<string, HRMS.Models.EmployeeModel>();
    var typeLookup = ViewBag.LeaveTypeLookup as Dictionary<string, HRMS.Models.LeaveTypeModel> ?? new Dictionary<string, HRMS.Models.LeaveTypeModel>();
    var deptLookup = ViewBag.DepartmentLookup as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="bi bi-check2-circle text-teal me-2" style="color:#0d9488;"></i> Leave Approval Queue
        </h4>
        <div class="text-muted small">Review, approve, or reject employee leave requests with audit trails</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="LeaveApplication" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-journal-text me-1"></i> All Applications
        </a>
    </div>
</div>

<!-- Pending Applications Table -->
<div class="card border shadow-sm rounded-3 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <div class="fw-semibold text-dark">
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle me-2">Pending Action</span>
            @Model.Count Application(s) Awaiting Review
        </div>
    </div>
    <div class="table-responsive">
        <table class="table hrms-table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th>Application Date</th>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Leave Type</th>
                    <th>Period</th>
                    <th>Days</th>
                    <th>Reason</th>
                    <th class="text-end" style="width: 170px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-check-all fs-1 d-block mb-2 text-success"></i>
                            <div class="fw-semibold">All caught up! No pending leave applications to review.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var app in Model)
                    {
                        empLookup.TryGetValue(app.EmployeeId, out var emp);
                        typeLookup.TryGetValue(app.LeaveTypeId, out var lt);
                        string dept = emp?.DepartmentId != null && deptLookup.TryGetValue(emp.DepartmentId, out var dn) ? dn : "General";

                        <tr>
                            <td class="small font-monospace">@app.ApplicationDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="fw-bold text-dark">@(emp?.FullName ?? "--")</div>
                                <div class="text-muted small font-monospace">@(emp?.EmployeeNo ?? "--")</div>
                            </td>
                            <td><span class="badge bg-light text-secondary border">@dept</span></td>
                            <td>
                                <span class="badge bg-light text-teal border fw-semibold">
                                    @(lt?.LeaveName ?? app.LeaveTypeId)
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">
                                    @app.FromDate.ToString("dd MMM")
                                    @if (app.FromDate != app.ToDate)
                                    {
                                        <span> — @app.ToDate.ToString("dd MMM")</span>
                                    }
                                </div>
                                @if (app.IsHalfDay)
                                {
                                    <span class="badge bg-light text-muted border small">Half Day</span>
                                }
                            </td>
                            <td class="fw-bold font-monospace fs-6">@app.TotalDays</td>
                            <td class="small text-truncate" style="max-width: 180px;" title="@app.Reason">
                                @app.Reason
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@app.LeaveApplicationId" class="btn btn-primary" style="background-color:#0f766e; border-color:#0f766e;" title="Review & Approve">
                                        <i class="bi bi-eye me-1"></i> Review
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

