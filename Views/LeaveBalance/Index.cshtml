@model IReadOnlyList<HRMS.ViewModels.EmployeeLeaveBalanceSummaryViewModel>
@{
    ViewData["Title"] = "Employee Leave Balances";
    int selectedYear = ViewBag.SelectedYear ?? DateTime.Today.Year;
    string? selectedDeptId = ViewBag.SelectedDepartmentId;
    string? searchTerm = ViewBag.SearchTerm;
    var departments = ViewBag.Departments as IReadOnlyList<HRMS.Models.DepartmentModel> ?? new List<HRMS.Models.DepartmentModel>();
    var leaveTypes = ViewBag.LeaveTypes as IReadOnlyList<HRMS.Models.LeaveTypeModel> ?? new List<HRMS.Models.LeaveTypeModel>();
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="bi bi-wallet2 text-teal me-2" style="color:#0d9488;"></i> Employee Leave Balances
        </h4>
        <div class="text-muted small">Financial Year @selectedYear &bull; Available balance ledger and entitlement overview</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="LeaveReport" asp-action="Transactions" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="bi bi-receipt me-1"></i> Transaction Ledger
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Financial Year</label>
                <select name="year" class="form-select form-select-sm" onchange="this.form.submit();">
                    @for (int y = selectedYear - 2; y <= selectedYear + 1; y++)
                    {
                        <option value="@y" selected="@(y == selectedYear)">@y</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small text-muted mb-1">Department</label>
                <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit();">
                    <option value="">All Departments</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.DepartmentId" selected="@(d.DepartmentId == selectedDeptId)">@d.DepartmentName</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-7">
                <label class="form-label small text-muted mb-1">Search Employee</label>
                <div class="input-group input-group-sm">
                    <input type="text" name="searchTerm" value="@searchTerm" class="form-control" placeholder="Search by employee name or EMP ID..." />
                    <button type="submit" class="btn btn-outline-secondary px-3 d-flex align-items-center justify-content-center" style="height: 31px;" title="Filter Balances">
                        <i class="bi bi-funnel"></i>
                    </button>
                    @if (!string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(selectedDeptId))
                    {
                        <a asp-action="Index" asp-route-year="@selectedYear" class="btn btn-outline-secondary d-flex align-items-center" title="Reset Filters" style="height: 31px;">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Balance Matrix Table -->
<div class="card border shadow-sm rounded-3 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table hrms-table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th style="min-width: 180px;">Employee</th>
                    <th>Department</th>
                    @foreach (var lt in leaveTypes)
                    {
                        <th class="text-center" title="@lt.LeaveName">@lt.LeaveCode</th>
                    }
                    <th class="text-center fw-bold text-teal">Total Available</th>
                    <th class="text-end" style="width: 100px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="@(4 + leaveTypes.Count)" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                            <div>No employee balance records match your filter criteria.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var empSummary in Model)
                    {
                        double totalAvail = empSummary.Balances.Where(b => b.IsPaidLeave).Sum(b => b.AvailableBalance);
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@empSummary.Employee.FullName</div>
                                <div class="text-muted small font-monospace">@empSummary.Employee.EmployeeNo</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">@empSummary.DepartmentName</span>
                            </td>
                            @foreach (var lt in leaveTypes)
                            {
                                var b = empSummary.Balances.FirstOrDefault(item => string.Equals(item.LeaveTypeId, lt.LeaveTypeId, StringComparison.OrdinalIgnoreCase));
                                double avail = b?.AvailableBalance ?? 0;
                                <td class="text-center">
                                    <span class="fw-semibold @(avail > 0 ? "text-dark" : "text-muted") font-monospace">
                                        @avail
                                    </span>
                                </td>
                            }
                            <td class="text-center">
                                <span class="badge bg-teal-subtle text-teal border px-2 py-1 font-monospace fw-bold" style="font-size:0.88rem;">
                                    @totalAvail Days
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-employeeId="@empSummary.Employee.EmployeeId" asp-route-year="@selectedYear" class="btn btn-outline-secondary btn-sm" title="View Full Ledger & Adjust Balance">
                                    <i class="bi bi-receipt"></i> Details
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
