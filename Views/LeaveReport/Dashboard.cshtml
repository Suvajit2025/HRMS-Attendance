@model HRMS.ViewModels.LeaveDashboardViewModel
@{
    ViewData["Title"] = "Leave Management Dashboard";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="bi bi-speedometer2 text-teal me-2" style="color:#0d9488;"></i> Leave Management Dashboard
        </h4>
        <div class="text-muted small">Workforce leave analytics, pending authorization queues, and attendance availability</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="LeaveApplication" asp-action="Create" class="btn btn-hrms-teal btn-sm px-3 shadow-sm">
            <i class="bi bi-pencil-square me-1"></i> Apply Leave
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="bi bi-file-earmark-bar-graph me-1"></i> Leave Reports
        </a>
    </div>
</div>

<!-- 5 KPI Cards -->
<div class="row g-2 g-sm-3 mb-4">
    <div class="col-6 col-md-4 col-xl">
        <div class="kpi-card">
            <div class="kpi-icon-wrap kpi-icon-teal">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <div class="kpi-number">@Model.TotalEmployees</div>
                <div class="kpi-label">Active Workforce</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="kpi-card">
            <div class="kpi-icon-wrap kpi-icon-amber">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div>
                <div class="kpi-number">@Model.PendingApplicationsCount</div>
                <div class="kpi-label">Pending Approval</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="kpi-card">
            <div class="kpi-icon-wrap kpi-icon-green">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div>
                <div class="kpi-number">@Model.ApprovedApplicationsCount</div>
                <div class="kpi-label">Approved Applications</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="kpi-card">
            <div class="kpi-icon-wrap kpi-icon-blue">
                <i class="bi bi-person-walking"></i>
            </div>
            <div>
                <div class="kpi-number">@Model.EmployeesOnLeaveTodayCount</div>
                <div class="kpi-label">On Leave Today</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="kpi-card">
            <div class="kpi-icon-wrap kpi-icon-purple">
                <i class="bi bi-wallet2"></i>
            </div>
            <div>
                <div class="kpi-number">@Model.TotalAvailableBalance</div>
                <div class="kpi-label">Total Leave Pool</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Pending Approval List -->
    <div class="col-lg-8">
        <div class="card border shadow-sm rounded-3 overflow-hidden h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-inbox text-teal me-2" style="color:#0d9488;"></i> Pending Applications Awaiting Review</h6>
                <a asp-controller="LeaveApproval" asp-action="Index" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size:0.75rem;">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table hrms-table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Employee</th>
                            <th>Leave Type</th>
                            <th>Period</th>
                            <th>Days</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PendingApplications.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="bi bi-check-circle fs-2 d-block mb-1 text-success"></i>
                                    <div>No pending leave requests!</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var app in Model.PendingApplications)
                            {
                                Model.EmployeeLookup.TryGetValue(app.EmployeeId, out var emp);
                                Model.LeaveTypeLookup.TryGetValue(app.LeaveTypeId, out var lt);

                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@(emp?.FullName ?? "--")</div>
                                        <div class="text-muted small font-monospace">@(emp?.EmployeeNo ?? "--")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-teal border fw-semibold">
                                            @(lt?.LeaveName ?? app.LeaveTypeId)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-dark">
                                            @app.FromDate.ToString("dd MMM")
                                            @if (app.FromDate != app.ToDate)
                                            {
                                                <span> — @app.ToDate.ToString("dd MMM")</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="fw-bold font-monospace">@app.TotalDays</td>
                                    <td class="text-end">
                                        <a asp-controller="LeaveApproval" asp-action="Details" asp-route-id="@app.LeaveApplicationId" class="btn btn-primary btn-sm py-1 px-2" style="background-color:#0f766e; border-color:#0f766e; font-size:0.75rem;">
                                            Review
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- On Leave Today Widget -->
    <div class="col-lg-4">
        <div class="card border shadow-sm rounded-3 overflow-hidden h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-person-dash text-danger me-2"></i> On Leave Today (@DateTime.Today.ToString("dd MMM"))</h6>
            </div>
            <div class="card-body p-3">
                @if (Model.TodayLeaves.Count == 0)
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-emoji-smile fs-1 d-block mb-2 text-success"></i>
                        <div class="small fw-semibold">No employees on leave today. Full workforce available.</div>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var app in Model.TodayLeaves)
                        {
                            Model.EmployeeLookup.TryGetValue(app.EmployeeId, out var emp);
                            Model.LeaveTypeLookup.TryGetValue(app.LeaveTypeId, out var lt);

                            <div class="list-group-item px-0 py-2 border-bottom">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold text-dark">@(emp?.FullName ?? "--")</div>
                                        <div class="text-muted small font-monospace">@(emp?.EmployeeNo ?? "--")</div>
                                    </div>
                                    <span class="badge bg-light text-teal border">
                                        @(lt?.LeaveCode ?? "LV")
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

