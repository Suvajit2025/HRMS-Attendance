@model HRMS.ViewModels.LeaveReportViewModel
@{
    ViewData["Title"] = "Leave Reports & Analytics";
    var totalDays = Model.Items.Sum(i => i.Application.TotalDays);
    var approvedItems = Model.Items.Where(i => i.Application.Status == "Approved").ToList();
    var approvedDays = approvedItems.Sum(i => i.Application.TotalDays);
    var paidDays = approvedItems.Where(i => i.IsPaid).Sum(i => i.Application.TotalDays);
    var unpaidDays = approvedItems.Where(i => !i.IsPaid).Sum(i => i.Application.TotalDays);
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="bi bi-file-earmark-bar-graph text-teal me-2" style="color:#0d9488;"></i> Leave Reports & Analytics
        </h4>
        <div class="text-muted small">Comprehensive employee leave utilization, audit records, and exportable analytics</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="DownloadExcel"
           asp-route-StartDate="@Model.Filter.StartDate.ToString("yyyy-MM-dd")"
           asp-route-EndDate="@Model.Filter.EndDate.ToString("yyyy-MM-dd")"
           asp-route-DepartmentId="@Model.Filter.DepartmentId"
           asp-route-LeaveTypeId="@Model.Filter.LeaveTypeId"
           asp-route-Status="@Model.Filter.Status"
           asp-route-SearchTerm="@Model.Filter.SearchTerm"
           class="btn btn-outline-success btn-sm d-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-file-earmark-excel"></i>
            <span class="fw-semibold">Download CSV</span>
        </a>
        <a asp-action="Transactions" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-journal-check"></i>
            <span>Transaction Ledger</span>
        </a>
    </div>
</div>

<!-- Filters Card (All items on the same line) -->
<div class="card border shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">From Date</label>
                <input type="date" name="StartDate" value="@Model.Filter.StartDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">To Date</label>
                <input type="date" name="EndDate" value="@Model.Filter.EndDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Department</label>
                <select name="DepartmentId" class="form-select form-select-sm" onchange="this.form.submit();">
                    <option value="">All Departments</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.DepartmentId" selected="@(dept.DepartmentId == Model.Filter.DepartmentId)">@dept.DepartmentName</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Leave Type</label>
                <select name="LeaveTypeId" class="form-select form-select-sm" onchange="this.form.submit();">
                    <option value="">All Leave Types</option>
                    @foreach (var lt in Model.LeaveTypes)
                    {
                        <option value="@lt.LeaveTypeId" selected="@(lt.LeaveTypeId == Model.Filter.LeaveTypeId)">@lt.LeaveName (@lt.LeaveCode)</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Status</label>
                <select name="Status" class="form-select form-select-sm" onchange="this.form.submit();">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Filter.Status))">All Statuses</option>
                    <option value="Approved" selected="@(Model.Filter.Status == "Approved")">Approved</option>
                    <option value="Pending" selected="@(Model.Filter.Status == "Pending")">Pending</option>
                    <option value="Rejected" selected="@(Model.Filter.Status == "Rejected")">Rejected</option>
                    <option value="Cancelled" selected="@(Model.Filter.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Search Employee</label>
                <div class="input-group input-group-sm">
                    <input type="text" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control" placeholder="Name or Emp No..." />
                    <button type="submit" class="btn btn-outline-secondary px-3 d-flex align-items-center justify-content-center" style="height: 31px;" title="Filter Report">
                        <i class="bi bi-funnel"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border shadow-sm rounded-3 p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Total Applications</div>
                    <div class="fs-4 fw-bold text-dark mt-1">@Model.Items.Count</div>
                </div>
                <div class="p-2 bg-light rounded text-secondary">
                    <i class="bi bi-file-earmark-text fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border shadow-sm rounded-3 p-3 h-100 bg-white border-start border-start-4 border-success">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-success small fw-semibold">Approved Leaves</div>
                    <div class="fs-4 fw-bold text-success mt-1">@approvedItems.Count (@approvedDays Days)</div>
                </div>
                <div class="p-2 bg-success-subtle rounded text-success">
                    <i class="bi bi-check-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border shadow-sm rounded-3 p-3 h-100 bg-white border-start border-start-4 border-info">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-info small fw-semibold">Paid Leave Days</div>
                    <div class="fs-4 fw-bold text-info mt-1">@paidDays Days</div>
                </div>
                <div class="p-2 bg-info-subtle rounded text-info">
                    <i class="bi bi-cash-coin fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border shadow-sm rounded-3 p-3 h-100 bg-white border-start border-start-4 border-warning">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-warning-emphasis small fw-semibold">Unpaid Leave Days</div>
                    <div class="fs-4 fw-bold text-warning-emphasis mt-1">@unpaidDays Days</div>
                </div>
                <div class="p-2 bg-warning-subtle rounded text-warning-emphasis">
                    <i class="bi bi-dash-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Report Table -->
<div class="card border shadow-sm rounded-3 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table hrms-table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Application Ref</th>
                    <th>Employee</th>
                    <th>Department</th>
                    <th>Leave Type</th>
                    <th>Period</th>
                    <th class="text-center">Days</th>
                    <th>Status</th>
                    <th>Reason</th>
                    <th class="text-end pe-3">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            No leave applications found for the selected criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        var app = item.Application;
                        string badgeClass = app.Status switch
                        {
                            "Approved" => "bg-success-subtle text-success border border-success-subtle",
                            "Pending" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                            "Rejected" => "bg-danger-subtle text-danger border border-danger-subtle",
                            "Cancelled" => "bg-secondary-subtle text-secondary border",
                            _ => "bg-light text-dark border"
                        };

                        <tr>
                            <td class="font-monospace small fw-bold">@app.LeaveApplicationId</td>
                            <td>
                                <div class="fw-semibold text-dark">@item.EmployeeName</div>
                                <div class="text-muted small">@item.EmployeeNo</div>
                            </td>
                            <td><span class="badge bg-light text-dark border">@item.DepartmentName</span></td>
                            <td>
                                <span class="fw-semibold">@item.LeaveName</span>
                                <span class="badge @(item.IsPaid ? "bg-info-subtle text-info border border-info-subtle" : "bg-secondary-subtle text-secondary border") ms-1 small">
                                    @(item.IsPaid ? "Paid" : "Unpaid")
                                </span>
                            </td>
                            <td>
                                <div class="small fw-semibold">@app.FromDate.ToString("dd MMM yyyy") — @app.ToDate.ToString("dd MMM yyyy")</div>
                                @if (app.IsHalfDay)
                                {
                                    <div class="text-muted small"><i class="bi bi-clock me-1"></i>Half-day (@app.HalfDaySession)</div>
                                }
                            </td>
                            <td class="text-center fw-bold">@app.TotalDays.ToString("0.#")</td>
                            <td><span class="badge @badgeClass px-2 py-1">@app.Status</span></td>
                            <td class="small text-muted text-truncate" style="max-width: 200px;" title="@app.Reason">@(string.IsNullOrEmpty(app.Reason) ? "—" : app.Reason)</td>
                            <td class="text-end pe-3">
                                <a asp-controller="LeaveApplication" asp-action="Details" asp-route-id="@app.LeaveApplicationId" class="btn btn-outline-secondary btn-sm py-0 px-2" title="View Application">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

