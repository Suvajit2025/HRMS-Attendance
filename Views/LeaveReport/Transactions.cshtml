@model IReadOnlyList<HRMS.Models.LeaveTransactionModel>
@{
    ViewData["Title"] = "Leave Audit Ledger";
    var employees = ViewBag.Employees as IReadOnlyList<HRMS.Models.EmployeeModel> ?? new List<HRMS.Models.EmployeeModel>();
    var empLookup = ViewBag.EmployeeLookup as Dictionary<string, HRMS.Models.EmployeeModel> ?? new Dictionary<string, HRMS.Models.EmployeeModel>();
    var typeLookup = ViewBag.LeaveTypeLookup as Dictionary<string, HRMS.Models.LeaveTypeModel> ?? new Dictionary<string, HRMS.Models.LeaveTypeModel>();
    string? selectedEmpId = ViewBag.SelectedEmployeeId as string;

    var totalAccruals = Model.Where(t => t.TransactionType == "Opening" || t.TransactionType == "Accrual" || (t.TransactionType == "Adjustment" && t.Quantity > 0)).Sum(t => t.Quantity);
    var totalConsumed = Model.Where(t => t.TransactionType == "LeaveConsumed").Sum(t => t.Quantity);
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="bi bi-shield-check text-teal me-2" style="color:#0d9488;"></i> Leave Audit Ledger
        </h4>
        <div class="text-muted small">Immutable transaction log of leave allocations, reservations, consumption, and adjustments</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-file-earmark-bar-graph me-1"></i> Leave Reports
        </a>
        <a asp-controller="LeaveBalance" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-wallet2 me-1"></i> Leave Balances
        </a>
    </div>
</div>

<!-- Filter Card (All on the same line) -->
<div class="card border shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Transactions" class="row g-2 align-items-end">
            <div class="col-12 col-md-6 col-lg-5">
                <label class="form-label small text-muted mb-1">Filter by Employee</label>
                <div class="input-group input-group-sm">
                    <select name="employeeId" class="form-select" onchange="this.form.submit();">
                        <option value="">All Employees (System Wide Ledger)</option>
                        @foreach (var emp in employees)
                        {
                            <option value="@emp.EmployeeId" selected="@(emp.EmployeeId == selectedEmpId)">
                                @emp.EmployeeNo — @emp.FullName
                            </option>
                        }
                    </select>
                    <button type="submit" class="btn btn-outline-secondary px-3 d-flex align-items-center justify-content-center" style="height: 31px;" title="Filter Transactions">
                        <i class="bi bi-funnel"></i>
                    </button>
                    @if (!string.IsNullOrEmpty(selectedEmpId))
                    {
                        <a asp-action="Transactions" class="btn btn-outline-secondary d-flex align-items-center" title="Reset Filter" style="height: 31px;">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Ledger Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card border shadow-sm rounded-3 p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Total Ledger Entries</div>
                    <div class="fs-4 fw-bold text-dark mt-1">@Model.Count</div>
                </div>
                <div class="p-2 bg-light rounded text-secondary">
                    <i class="bi bi-journal-text fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border shadow-sm rounded-3 p-3 h-100 bg-white border-start border-start-4 border-success">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-success small fw-semibold">Total Accrued / Credited</div>
                    <div class="fs-4 fw-bold text-success mt-1">+@totalAccruals.ToString("0.#") Days</div>
                </div>
                <div class="p-2 bg-success-subtle rounded text-success">
                    <i class="bi bi-plus-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border shadow-sm rounded-3 p-3 h-100 bg-white border-start border-start-4 border-danger">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-danger small fw-semibold">Total Consumed (Approved)</div>
                    <div class="fs-4 fw-bold text-danger mt-1">-@totalConsumed.ToString("0.#") Days</div>
                </div>
                <div class="p-2 bg-danger-subtle rounded text-danger">
                    <i class="bi bi-dash-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Ledger Table -->
<div class="card border shadow-sm rounded-3 overflow-hidden mb-4">
    <div class="table-responsive" style="max-height: 70vh; overflow-y: auto;">
        <table class="table hrms-table table-hover align-middle mb-0">
            <thead class="table-light sticky-top" style="z-index: 5;">
                <tr>
                    <th>Timestamp</th>
                    <th>Employee</th>
                    <th>Leave Type</th>
                    <th>Transaction Type</th>
                    <th class="text-end">Quantity</th>
                    <th>Reference</th>
                    <th>Remarks</th>
                    <th>Created By</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
                            No transaction records recorded in the ledger yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var txn in Model.OrderByDescending(t => t.TransactionDate))
                    {
                        empLookup.TryGetValue(txn.EmployeeId, out var emp);
                        typeLookup.TryGetValue(txn.LeaveTypeId, out var lt);

                        string badgeClass = txn.TransactionType switch
                        {
                            "Opening" => "bg-primary-subtle text-primary border border-primary-subtle",
                            "Accrual" => "bg-success-subtle text-success border border-success-subtle",
                            "LeaveReserved" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                            "LeaveConsumed" => "bg-danger-subtle text-danger border border-danger-subtle",
                            "LeaveReleased" => "bg-info-subtle text-info border border-info-subtle",
                            "Adjustment" => "bg-secondary-subtle text-secondary border",
                            "Lapse" => "bg-dark-subtle text-dark border",
                            _ => "bg-light text-dark border"
                        };

                        string qtyDisplay = txn.TransactionType switch
                        {
                            "Opening" or "Accrual" => $"+{txn.Quantity:0.#}",
                            "LeaveConsumed" => $"-{txn.Quantity:0.#}",
                            "LeaveReserved" => $"({txn.Quantity:0.#})",
                            "LeaveReleased" => $"+{txn.Quantity:0.#}",
                            _ => $"{txn.Quantity:0.#}"
                        };

                        string qtyColor = txn.TransactionType switch
                        {
                            "Opening" or "Accrual" or "LeaveReleased" => "text-success",
                            "LeaveConsumed" => "text-danger",
                            "LeaveReserved" => "text-warning-emphasis",
                            _ => "text-dark"
                        };

                        <tr>
                            <td class="small text-muted font-monospace">@txn.TransactionDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>
                                <div class="fw-semibold text-dark">@(emp?.FullName ?? txn.EmployeeId)</div>
                                <div class="text-muted small">@(emp?.EmployeeNo ?? "—")</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@(lt?.LeaveName ?? txn.LeaveTypeId)</span>
                            </td>
                            <td>
                                <span class="badge @badgeClass px-2 py-1">@txn.TransactionType</span>
                            </td>
                            <td class="text-end fw-bold font-monospace @qtyColor">@qtyDisplay</td>
                            <td class="small font-monospace text-muted">@(string.IsNullOrEmpty(txn.Reference) ? (txn.LeaveApplicationId ?? "—") : txn.Reference)</td>
                            <td class="small text-muted">@txn.Remarks</td>
                            <td class="small text-muted">@txn.CreatedBy</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
