<header class="hrms-topbar">
    <div class="d-flex align-items-center overflow-hidden me-2">
        <!-- Single hamburger toggle button for both Desktop and Mobile -->
        <button type="button" class="btn btn-outline-secondary btn-sm me-2 me-sm-3 flex-shrink-0" id="btnTopbarBurger" aria-label="Toggle Navigation" title="Toggle Sidebar Navigation">
            <i class="bi bi-list fs-5"></i>
        </button>
        <h1 class="hrms-page-title text-truncate">
            @ViewData["Title"]
        </h1>
    </div>

    <div class="d-flex align-items-center gap-3">
        <div class="hrms-clock-pill d-none d-md-flex" id="hrmsLiveClock">
            <i class="bi bi-clock"></i> Live Clock
        </div>

        <a asp-controller="Attendance" asp-action="Terminal" class="btn btn-hrms-teal btn-sm px-3 d-none d-sm-inline-flex align-items-center gap-1 shadow-sm">
            <i class="bi bi-camera-video"></i>
            <span>Terminal</span>
        </a>

        <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle"></i>
                <span class="d-none d-sm-inline fw-semibold">@User.Identity?.Name</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                <li><h6 class="dropdown-header">Workforce Administration</h6></li>
                <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="bi bi-sliders me-2"></i> Settings</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-1">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm w-100">
                            <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</header>
