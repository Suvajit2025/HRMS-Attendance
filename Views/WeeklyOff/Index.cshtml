@model IReadOnlyList<HRMS.Models.WeeklyOffModel>
@{
    ViewData["Title"] = "Weekly Off Configuration";
    var deptDict = ViewBag.Departments as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="bi bi-calendar-week-fill text-teal me-2" style="color:#0d9488;"></i> Weekly Off Configuration
        </h4>
        <div class="text-muted small">Configure organization, plant, and department recurring rest days</div>
    </div>
    <a asp-action="Configure" class="btn btn-hrms-teal btn-sm px-3 d-flex align-items-center gap-1 shadow-sm">
        <i class="bi bi-plus-circle-fill"></i> Add Weekly Off Rule
    </a>
</div>

<!-- Table Card -->
<div class="card border shadow-sm rounded-3 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table hrms-table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th>Day of Week</th>
                    <th>Pattern / Frequency</th>
                    <th>Applicable Scope</th>
                    <th>Effective From</th>
                    <th>Effective To</th>
                    <th>Status</th>
                    <th class="text-end" style="width: 120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar2-range fs-1 d-block mb-2"></i>
                            <div>No custom weekly off rules found. Default Sunday off is currently in effect.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var off in Model)
                    {
                        string scope = !string.IsNullOrEmpty(off.DepartmentId) && deptDict.TryGetValue(off.DepartmentId, out var dn)
                            ? $"Department: {dn}"
                            : (!string.IsNullOrEmpty(off.LocationCode) ? $"Location: {off.LocationCode}" : "Entire Organization");

                        string pattern = off.IsAlternateWeek
                            ? $"Alternate Week ({off.AlternateWeekNumber}th {off.DayOfWeek})"
                            : $"Every {off.DayOfWeek}";

                        <tr>
                            <td class="fw-bold text-dark">
                                <i class="bi bi-calendar-day me-1 text-teal"></i> @off.DayOfWeek
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@pattern</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">@scope</span>
                            </td>
                            <td class="small font-monospace">@off.EffectiveFrom.ToString("dd MMM yyyy")</td>
                            <td class="small font-monospace">@(off.EffectiveTo.HasValue ? off.EffectiveTo.Value.ToString("dd MMM yyyy") : "Ongoing")</td>
                            <td>
                                @if (off.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Configure" asp-route-id="@off.WeeklyOffId" class="btn btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@off.WeeklyOffId" method="post" class="d-inline" onsubmit="return confirm('Remove weekly off rule for @off.DayOfWeek?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

